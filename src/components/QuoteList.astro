---
import { type Quote } from '../lib/content';

type Props = {
  quotes: Quote[];
};

const { quotes } = Astro.props;
---

{
  quotes.length > 0 && (
    <section class="aside-section">
      <h2 class="aside-title">Citas</h2>

      <ul class="mt-5 space-y-6">
        {quotes.map((quote) => (
          <li class="quote-item">
            <blockquote class="quote-item-text">{quote.text}</blockquote>

            {quote.page && <p class="muted mt-1.5 text-sm">{quote.page}</p>}
          </li>
        ))}
      </ul>

      <a href="/quotes/" class="section-link mt-6 inline-block">Ver todas las citas del sitio</a>
    </section>
  )
}
