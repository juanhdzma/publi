---
import { type Quote } from '../lib/content';

type Props = {
  quotes: Quote[];
};

const { quotes } = Astro.props;
---

{
  quotes.length > 0 && (
    <section class="mt-14 border-t border-line pt-8 dark:border-line-dark">
      <h2 class="text-sm font-medium tracking-wide text-ink-muted uppercase dark:text-ink-muted-dark">
        Citas
      </h2>

      <ul class="mt-5 space-y-6">
        {quotes.map((quote) => (
          <li class="border-l-2 border-line pl-5 dark:border-line-dark">
            <blockquote class="font-serif leading-snug text-pretty">{quote.text}</blockquote>

            {quote.page && (
              <p class="mt-1.5 text-sm text-ink-muted dark:text-ink-muted-dark">
                {quote.page}
              </p>
            )}
          </li>
        ))}
      </ul>

      <a
        href="/quotes/"
        class="mt-6 inline-block text-sm text-ink-muted transition-colors hover:text-accent dark:text-ink-muted-dark dark:hover:text-accent-dark"
      >
        Ver todas las citas del sitio
      </a>
    </section>
  )
}
