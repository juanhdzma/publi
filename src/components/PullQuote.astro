---
type Props = {
  text: string;
  source?: string;
  page?: string;
};

const { text, source, page } = Astro.props;

const attribution = [source, page].filter(Boolean).join(', ');
---

<figure class="relative my-10 border-l-2 border-accent/50 pl-6 dark:border-accent-dark/50">
  <span
    class="absolute -top-4 -left-1 font-serif text-6xl leading-none text-accent/20 select-none dark:text-accent-dark/20"
    aria-hidden="true">&ldquo;</span
  >

  <blockquote class="font-serif text-xl leading-snug text-pretty italic">
    {text}
  </blockquote>

  {
    attribution && (
      <figcaption class="mt-3 text-sm text-ink-muted not-italic dark:text-ink-muted-dark">
        <span aria-hidden="true">—</span> <cite class="not-italic">{attribution}</cite>
      </figcaption>
    )
  }
</figure>
