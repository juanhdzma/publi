---
type Props = {
  text: string;
  source?: string;
  page?: string;
};

const { text, source, page } = Astro.props;

const attribution = [source, page].filter(Boolean).join(', ');
---

<figure class="pull-quote">
  <span class="pull-quote-mark" aria-hidden="true">&ldquo;</span>

  <blockquote class="pull-quote-text">{text}</blockquote>

  {
    attribution && (
      <figcaption class="pull-quote-caption">
        <span aria-hidden="true">—</span> <cite class="not-italic">{attribution}</cite>
      </figcaption>
    )
  }
</figure>
