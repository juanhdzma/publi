---
import { tagHref } from '../lib/content';

type Props = {
  tags: string[];
  size?: 'sm' | 'md';
};

const { tags, size = 'sm' } = Astro.props;
---

{
  tags.length > 0 && (
    <ul class="flex flex-wrap gap-1.5">
      {tags.map((tag) => (
        <li>
          <a
            href={tagHref(tag)}
            class={`chip ${size === 'sm' ? 'chip-sm' : 'chip-md'} text-ink-muted dark:text-ink-muted-dark`}
          >
            {tag}
          </a>
        </li>
      ))}
    </ul>
  )
}
