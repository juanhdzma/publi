---
type Props = {
  title: string;
  href?: string;
  linkLabel?: string;
};

const { title, href, linkLabel = 'Ver todas' } = Astro.props;
---

<div class="section-header">
  <h2 class="section-title">{title}</h2>

  {
    href && (
      <a href={href} class="section-link">
        {linkLabel}
      </a>
    )
  }
</div>
