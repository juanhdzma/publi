---
import Rating from './Rating.astro';
import { formatDate, slugifyTag, type ContentItem } from '../lib/content';

type Props = {
  item: ContentItem;
};

const { item } = Astro.props;

const tagSlugs = item.tags.map(slugifyTag).join(' ');
---

<li
  class="group relative border-b border-line last:border-0 dark:border-line-dark"
  data-entry-tags={tagSlugs}
>
  <a href={item.href} class="block py-4">
    <h3 class="font-serif text-lg leading-snug text-pretty transition-colors group-hover:text-accent dark:group-hover:text-accent-dark">
      {item.title}
    </h3>

    <div class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-ink-muted dark:text-ink-muted-dark">
      {
        item.author && (
          <>
            <span class="truncate">{item.author}</span>
            <span aria-hidden="true">·</span>
          </>
        )
      }
      <time datetime={item.publishedAt.toISOString()}>{formatDate(item.publishedAt)}</time>
      <span aria-hidden="true">·</span>
      <span>{item.readingMinutes} min</span>
      {item.rating && <Rating value={item.rating} />}
    </div>
  </a>
</li>
