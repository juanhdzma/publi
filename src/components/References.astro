---
type Reference = {
  title: string;
  author?: string;
  year?: string;
  url?: string;
  note?: string;
};

type Props = {
  references: Reference[];
};

const { references } = Astro.props;
---

{
  references.length > 0 && (
    <section class="aside-section">
      <h2 class="aside-title">Referencias</h2>

      <ol class="mt-5 space-y-4 text-sm">
        {references.map((ref, i) => (
          <li class="grid grid-cols-[1.75rem_1fr] items-baseline">
            <span class="ref-index">[{i + 1}]</span>

            <span>
              {ref.author && <span>{ref.author}. </span>}

              {ref.url ? (
                <a href={ref.url} rel="noopener noreferrer" class="ref-link">
                  <cite class="not-italic">{ref.title}</cite>
                </a>
              ) : (
                <cite>{ref.title}</cite>
              )}

              {ref.year && <span class="muted"> ({ref.year})</span>}

              {ref.note && (
                <span class="muted mt-0.5 block">{ref.note}</span>
              )}
            </span>
          </li>
        ))}
      </ol>
    </section>
  )
}
