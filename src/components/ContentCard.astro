---
import Rating from './Rating.astro';
import TagList from './TagList.astro';
import { KIND_LABEL, formatDate, type ContentItem } from '../lib/content';

type Props = {
  item: ContentItem;
  showKind?: boolean;
};

const { item, showKind = false } = Astro.props;
---

<article
  class="group relative flex h-full flex-col rounded-xl border border-line p-5 transition-colors hover:border-accent/40 hover:bg-accent/[0.03] dark:border-line-dark dark:hover:border-accent-dark/40 dark:hover:bg-accent-dark/[0.06]"
>
  <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1 text-xs text-ink-muted dark:text-ink-muted-dark">
    {
      showKind && (
        <span class="font-medium tracking-wide text-accent uppercase dark:text-accent-dark">
          {KIND_LABEL[item.kind]}
        </span>
      )
    }
    <time datetime={item.publishedAt.toISOString()}>{formatDate(item.publishedAt)}</time>
    <span aria-hidden="true">·</span>
    <span>{item.readingMinutes} min</span>
  </div>

  <h3 class="mt-2.5 text-lg font-semibold tracking-tight text-balance">
    <a
      href={item.href}
      class="transition-colors before:absolute before:inset-0 before:rounded-xl group-hover:text-accent dark:group-hover:text-accent-dark"
    >
      {item.title}
    </a>
  </h3>

  {
    item.author && (
      <p class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-ink-muted dark:text-ink-muted-dark">
        <span>{item.author}</span>
        {item.rating && <Rating value={item.rating} />}
      </p>
    )
  }

  <p class="mt-2.5 grow text-sm leading-relaxed text-pretty text-ink-muted dark:text-ink-muted-dark">
    {item.summary}
  </p>

  <div class="relative z-10 mt-4">
    <TagList tags={item.tags} />
  </div>
</article>
