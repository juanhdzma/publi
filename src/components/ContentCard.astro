---
import Rating from './Rating.astro';
import TagList from './TagList.astro';
import { KIND_LABEL, formatDate, type ContentItem } from '../lib/content';

type Props = {
  item: ContentItem;
  showKind?: boolean;
  /** El nivel depende de qué encabezado tenga arriba en cada página. */
  level?: 2 | 3 | 4;
};

const { item, showKind = false, level = 3 } = Astro.props;

const Heading = `h${level}` as const;
---

<article class="entry">
  <div class="meta-row">
    {showKind && <span class="meta-kind">{KIND_LABEL[item.kind]}</span>}
    <time datetime={item.publishedAt.toISOString()}>{formatDate(item.publishedAt)}</time>
    <span aria-hidden="true">·</span>
    <span>{item.readingMinutes} min</span>
  </div>

  <Heading class="entry-title">
    <a href={item.href} class="entry-link">{item.title}</a>
  </Heading>

  {
    item.author && (
      <p class="entry-byline">
        <span>{item.author}</span>
        {item.rating && <Rating value={item.rating} />}
      </p>
    )
  }

  <p class="entry-summary">{item.summary}</p>

  <div class="relative z-10 mt-3.5">
    <TagList tags={item.tags} />
  </div>
</article>
