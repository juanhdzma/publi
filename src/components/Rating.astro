---
type Props = {
  value: number;
  max?: number;
};

const { value, max = 5 } = Astro.props;
---

<span
  class="inline-flex gap-px align-middle text-accent dark:text-accent-dark"
  role="img"
  aria-label={`${value} de ${max}`}
>
  {
    Array.from({ length: max }, (_, i) => (
      <svg
        class={`size-3.5 ${i < value ? 'fill-current' : 'fill-current opacity-20'}`}
        viewBox="0 0 20 20"
        aria-hidden="true"
      >
        <path d="M10 1.6l2.6 5.3 5.8.8-4.2 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8L1.6 7.7l5.8-.8z" />
      </svg>
    ))
  }
</span>
