---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentCard from '../../components/ContentCard.astro';
import { getPublished } from '../../lib/content';

const items = await getPublished('essays');
---

<BaseLayout title="Ensayos" description="Ensayos.">
  <h1 class="text-3xl font-semibold tracking-tight">Ensayos</h1>
  <p class="mt-3 text-ink-muted dark:text-ink-muted-dark">
    Textos propios, cuando tengo algo que decir.
  </p>

  <div class="mt-8">
    {items.map((item) => <ContentCard item={item} />)}
  </div>

  {
    items.length === 0 && (
      <p class="mt-8 text-ink-muted dark:text-ink-muted-dark">Todavía no hay ensayos.</p>
    )
  }
</BaseLayout>
