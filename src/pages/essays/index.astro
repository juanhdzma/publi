---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentCard from '../../components/ContentCard.astro';
import TagList from '../../components/TagList.astro';
import { getPublished } from '../../lib/content';

const items = await getPublished('essays');

const tags = [...new Set(items.flatMap((item) => item.tags))].sort((a, b) =>
  a.localeCompare(b, 'es'),
);
---

<BaseLayout title="Ensayos" description="Ensayos.">
  <header class="page-header">
    <h1 class="page-title">Ensayos</h1>
    <p class="page-intro">
      Textos propios, cuando tengo algo que decir. {items.length} en total.
    </p>

    <div class="mt-6">
      <TagList tags={tags} size="md" />
    </div>
  </header>

  <div class="mt-8 grid gap-4 sm:grid-cols-2">
    {items.map((item) => <ContentCard item={item} />)}
  </div>

  {
    items.length === 0 && (
      <p class="mt-8 text-ink-muted dark:text-ink-muted-dark">Todavía no hay ensayos.</p>
    )
  }
</BaseLayout>
