---
import { getCollection, render } from 'astro:content';
import ProseLayout from '../../layouts/ProseLayout.astro';
import { getPublished, parseId } from '../../lib/content';

export async function getStaticPaths() {
  const items = await getPublished('essays');
  const entries = await getCollection('essays', ({ data }: any) => !data.draft);

  return entries.map((entry: any) => ({
    params: { slug: parseId(entry.id).slug },
    props: { entry, item: items.find((i) => i.id === entry.id)! },
  }));
}

const { entry, item } = Astro.props;
const { Content } = await render(entry);
---

<ProseLayout
  kind="essays"
  title={entry.data.title}
  summary={entry.data.summary}
  publishedAt={entry.data.publishedAt}
  tags={entry.data.tags}
  mode={item.mode}
  readingMinutes={item.readingMinutes}
  references={entry.data.references}
  quotes={item.quotes}
>
  <Content />
</ProseLayout>
