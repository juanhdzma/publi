---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404" description="Página no encontrada.">
  <h1 class="text-3xl font-semibold tracking-tight">404</h1>
  <p class="mt-3 text-ink-muted dark:text-ink-muted-dark">
    Esta página no existe.
  </p>
  <a
    href="/"
    class="mt-6 inline-block text-accent hover:underline dark:text-accent-dark"
  >
    Volver al inicio
  </a>
</BaseLayout>
