---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentCard from '../../components/ContentCard.astro';
import { getAllTags, getByTag } from '../../lib/content';

export async function getStaticPaths() {
  const tags = await getAllTags();

  return Promise.all(
    tags.map(async (tag) => ({
      params: { tag: tag.slug },
      props: { name: tag.name, items: await getByTag(tag.slug) },
    })),
  );
}

const { name, items } = Astro.props;
---

<BaseLayout title={name} description={`Entradas en la categoría ${name}.`}>
  <a
    href="/tags/"
    class="text-sm text-ink-muted transition-colors hover:text-ink dark:text-ink-muted-dark dark:hover:text-ink-dark"
  >
    ← Categorías
  </a>

  <header class="mt-6 border-b border-line pb-6 dark:border-line-dark">
    <h1 class="font-serif text-4xl tracking-tight sm:text-5xl">{name}</h1>
    <p class="mt-3 text-ink-muted dark:text-ink-muted-dark">
      {items.length} {items.length === 1 ? 'entrada' : 'entradas'}
    </p>
  </header>

  <div class="mt-8 grid gap-4 sm:grid-cols-2">
    {items.map((item) => <ContentCard item={item} showKind />)}
  </div>
</BaseLayout>
