---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllTags } from '../../lib/content';

const tags = await getAllTags();

const counts = tags.map((tag) => tag.count);
const min = Math.min(...counts, 0);
const max = Math.max(...counts, 1);

/** 0 para la menos usada, 1 para la más usada. El tamaño lo resuelve el CSS. */
function weight(count: number): number {
  if (max === min) return 1;
  return Number(((count - min) / (max - min)).toFixed(3));
}
---

<BaseLayout title="Categorías" description="Todas las categorías del sitio.">
  <header class="page-header">
    <h1 class="page-title">Categorías</h1>
    <p class="page-intro">
      {tags.length} categorías. El tamaño indica cuánto se usa cada una. Una entrada puede
      estar en varias.
    </p>
  </header>

  {
    tags.length === 0 ? (
      <p class="mt-10 text-ink-muted dark:text-ink-muted-dark">Todavía no hay categorías.</p>
    ) : (
      <div class="tag-cloud mt-14 mb-6">
        {tags.map((tag) => (
          <a
            href={`/tags/${tag.slug}/`}
            class="cloud-tag"
            style={`--weight:${weight(tag.count)}`}
          >
            {tag.name}
            <span class="cloud-count">{tag.count}</span>
          </a>
        ))}
      </div>
    )
  }
</BaseLayout>
