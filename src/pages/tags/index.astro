---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllTags, KIND_PLURAL } from '../../lib/content';

const tags = await getAllTags();
---

<BaseLayout title="Categorías" description="Todas las categorías del sitio.">
  <header class="page-header">
    <h1 class="page-title">Categorías</h1>
    <p class="page-intro">
      {tags.length} categorías. Una entrada puede estar en varias, así que los números suman
      más que el total de entradas.
    </p>
  </header>

  {
    tags.length === 0 ? (
      <p class="mt-10 text-ink-muted dark:text-ink-muted-dark">Todavía no hay categorías.</p>
    ) : (
      <ul class="mt-4">
        {tags.map((tag) => (
          <li class="row group">
            <a
              href={`/tags/${tag.slug}/`}
              class="flex items-baseline justify-between gap-6 py-4"
            >
              <span class="row-name">{tag.name}</span>

              <span class="flex shrink-0 items-baseline gap-4">
                <span class="row-aside">
                  {tag.kinds.map((kind) => KIND_PLURAL[kind]).join(' · ')}
                </span>
                <span class="row-count">{tag.count}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>
