---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentRow from '../../components/ContentRow.astro';
import { getAllTags, getByTag, tagTotal } from '../../lib/content';

const tags = await getAllTags();

const sections = await Promise.all(
  tags.map(async (tag) => ({ ...tag, items: await getByTag(tag.slug) })),
);

const totals = tags.map(tagTotal);
const min = Math.min(...totals, 0);
const max = Math.max(...totals, 1);

/** 0 para la menos usada, 1 para la más usada. El tamaño lo resuelve el CSS. */
function weight(total: number): number {
  if (max === min) return 1;
  return Number(((total - min) / (max - min)).toFixed(3));
}

function summarize(count: number, quoteCount: number): string {
  return [
    count > 0 && `${count} ${count === 1 ? 'entrada' : 'entradas'}`,
    quoteCount > 0 && `${quoteCount} ${quoteCount === 1 ? 'cita' : 'citas'}`,
  ]
    .filter(Boolean)
    .join(' · ');
}
---

<BaseLayout title="Categorías" description="Todas las categorías del sitio.">
  <header class="page-header">
    <h1 class="page-title">Categorías</h1>
    <p class="page-intro">
      {tags.length} categorías. El tamaño indica cuánto se usa cada una. Una entrada puede
      estar en varias.
    </p>
  </header>

  {
    tags.length === 0 ? (
      <p class="mt-10 text-ink-muted dark:text-ink-muted-dark">Todavía no hay categorías.</p>
    ) : (
      <>
        <nav class="tag-cloud mt-12" aria-label="Índice de categorías">
          {tags.map((tag) => (
            <a href={`#${tag.slug}`} class="cloud-tag" style={`--weight:${weight(tagTotal(tag))}`}>
              {tag.name}
              <span class="cloud-count">{tagTotal(tag)}</span>
            </a>
          ))}
        </nav>

        <div class="mt-16 grid gap-x-10 gap-y-12 sm:grid-cols-2">
          {sections.map((section) => (
            <section id={section.slug} class="tag-section">
              <h2 class="tag-section-title">
                <a
                  href={`/tags/${section.slug}/`}
                  class="tag-section-name transition-colors hover:text-accent dark:hover:text-accent-dark"
                >
                  {section.name}
                </a>
                <span class="tag-section-count">
                  {summarize(section.count, section.quoteCount)}
                </span>
              </h2>

              {section.items.length > 0 && (
                <ul class="mt-1">
                  {section.items.map((item) => (
                    <ContentRow item={item} />
                  ))}
                </ul>
              )}

              {section.quoteCount > 0 && (
                <a href={`/tags/${section.slug}/`} class="section-link mt-3 inline-block">
                  Ver {section.quoteCount === 1 ? 'la cita' : `las ${section.quoteCount} citas`}
                </a>
              )}
            </section>
          ))}
        </div>
      </>
    )
  }
</BaseLayout>
