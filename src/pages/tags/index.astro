---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentRow from '../../components/ContentRow.astro';
import { getAllTags, getByTag, countLabel, tagTotal, type TagSummary } from '../../lib/content';

const tags = await getAllTags();

const sections = await Promise.all(
  tags.map(async (tag) => ({ ...tag, items: await getByTag(tag.slug) })),
);

const totals = tags.map(tagTotal);
const min = Math.min(...totals, 0);
const max = Math.max(...totals, 1);

/** 0 para la menos usada, 1 para la más usada. El tamaño lo resuelve el CSS. */
const weight = (tag: TagSummary) =>
  max === min ? 1 : Number(((tagTotal(tag) - min) / (max - min)).toFixed(3));
---

<BaseLayout title="Categorías" description="Todas las categorías del sitio.">
  <header class="page-header">
    <h1 class="page-title">Categorías</h1>

    <p class="page-intro">
      {
        tags.length === 0
          ? 'Todavía no hay categorías.'
          : `${tags.length} categorías. El tamaño indica cuánto se usa cada una. Una entrada puede estar en varias.`
      }
    </p>
  </header>

  <nav class="tag-cloud mt-12" aria-label="Índice de categorías">
    {
      tags.map((tag) => (
        <a href={`#${tag.slug}`} class="cloud-tag" style={`--weight:${weight(tag)}`}>
          {tag.name}
          <span class="cloud-count">{tagTotal(tag)}</span>
        </a>
      ))
    }
  </nav>

  <div class="mt-16 grid gap-x-10 gap-y-12 sm:grid-cols-2">
    {
      sections.map((section) => (
        <section id={section.slug} class="tag-section">
          <h2 class="section-header">
            <a href={`/tags/${section.slug}/`} class="tag-section-name hover-accent">
              {section.name}
            </a>
            <span class="tag-section-count">{countLabel(section.entries, section.quotes)}</span>
          </h2>

          {section.items.length > 0 && (
            <ul class="mt-1">
              {section.items.map((item) => (
                <ContentRow item={item} />
              ))}
            </ul>
          )}

          {section.quotes > 0 && (
            <a href={`/tags/${section.slug}/`} class="section-link mt-3 inline-block">
              Ver {section.quotes === 1 ? 'la cita' : `las ${section.quotes} citas`}
            </a>
          )}
        </section>
      ))
    }
  </div>
</BaseLayout>
