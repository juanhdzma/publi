---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentCard from '../../components/ContentCard.astro';
import TagList from '../../components/TagList.astro';
import { getPublished } from '../../lib/content';

const items = await getPublished('books');

const tags = [...new Set(items.flatMap((item) => item.tags))].sort((a, b) =>
  a.localeCompare(b, 'es'),
);
---

<BaseLayout title="Libros" description="Resúmenes de libros.">
  <header class="border-b border-line pb-6 dark:border-line-dark">
    <h1 class="text-4xl font-semibold tracking-tight">Libros</h1>
    <p class="mt-4 text-lg leading-relaxed text-ink-muted dark:text-ink-muted-dark">
      Resúmenes de lo que voy leyendo. {items.length} en total.
    </p>

    <div class="mt-6">
      <TagList tags={tags} size="md" />
    </div>
  </header>

  <div class="mt-8 grid gap-4 sm:grid-cols-2">
    {items.map((item) => <ContentCard item={item} />)}
  </div>

  {
    items.length === 0 && (
      <p class="mt-8 text-ink-muted dark:text-ink-muted-dark">Todavía no hay libros.</p>
    )
  }
</BaseLayout>
