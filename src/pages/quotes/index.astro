---
import BaseLayout from '../../layouts/BaseLayout.astro';
import QuoteCard from '../../components/QuoteCard.astro';
import { getAllQuotes } from '../../lib/content';

const quotes = await getAllQuotes();
const authors = new Set(quotes.map((q) => q.attribution)).size;
const loose = quotes.filter((q) => !q.kind).length;
---

<BaseLayout
  title="Citas"
  description="Frases que fui juntando, de los libros y ensayos del sitio y de por ahí."
>
  <header class="page-header">
    <h1 class="page-title">Citas</h1>

    <p class="page-intro">
      {
        quotes.length === 0
          ? 'Todavía no hay citas.'
          : `${quotes.length} frases de ${authors} ${authors === 1 ? 'autor' : 'autores'}. ${loose} sueltas, el resto salió de los libros y ensayos del sitio.`
      }
    </p>
  </header>

  <div class="mt-10 gap-x-12 sm:columns-2">
    {quotes.map((quote) => <QuoteCard quote={quote} />)}
  </div>
</BaseLayout>
