---
import BaseLayout from '../../layouts/BaseLayout.astro';
import QuoteCard from '../../components/QuoteCard.astro';
import { getAllQuotes } from '../../lib/content';

const quotes = await getAllQuotes();

const sources = [...new Set(quotes.map((q) => q.attribution))].sort((a, b) =>
  a.localeCompare(b, 'es'),
);
---

<BaseLayout
  title="Citas"
  description="Frases que fui juntando de los libros y ensayos del sitio."
>
  <header class="border-b border-line pb-6 dark:border-line-dark">
    <h1 class="text-4xl font-semibold tracking-tight">Citas</h1>
    <p class="mt-3 max-w-[60ch] text-ink-muted dark:text-ink-muted-dark">
      {quotes.length} frases de {sources.length} autores, juntadas de los libros y ensayos
      del sitio. Cada una enlaza a su entrada.
    </p>
  </header>

  {
    quotes.length === 0 ? (
      <p class="mt-10 text-ink-muted dark:text-ink-muted-dark">Todavía no hay citas.</p>
    ) : (
      <div class="mt-8 gap-4 sm:columns-2 [&>*]:mb-4">
        {quotes.map((quote) => (
          <QuoteCard quote={quote} />
        ))}
      </div>
    )
  }
</BaseLayout>
