---
import BaseLayout from '../../layouts/BaseLayout.astro';
import QuoteCard from '../../components/QuoteCard.astro';
import { getAllQuotes } from '../../lib/content';

const quotes = await getAllQuotes();

const sources = new Set(quotes.map((q) => q.attribution));
const loose = quotes.filter((q) => !q.kind).length;
---

<BaseLayout
  title="Citas"
  description="Frases que fui juntando, de los libros y ensayos del sitio y de por ahí."
>
  <header class="page-header">
    <h1 class="page-title">Citas</h1>
    <p class="page-intro">
      {quotes.length} frases de {sources.size} autores. {loose} sueltas, el resto salió de
      los libros y ensayos del sitio.
    </p>
  </header>

  {
    quotes.length === 0 ? (
      <p class="mt-10 text-ink-muted dark:text-ink-muted-dark">Todavía no hay citas.</p>
    ) : (
      <div class="mt-10 gap-x-12 sm:columns-2">
        {quotes.map((quote) => (
          <QuoteCard quote={quote} />
        ))}
      </div>
    )
  }
</BaseLayout>
