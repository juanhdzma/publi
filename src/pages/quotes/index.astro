---
import BaseLayout from '../../layouts/BaseLayout.astro';
import QuoteCard from '../../components/QuoteCard.astro';
import { getAllQuotes, splitByMode, MODES } from '../../lib/content';

const byMode = splitByMode(await getAllQuotes());

const summary = (quotes: typeof byMode.real) => ({
  total: quotes.length,
  authors: new Set(quotes.map((q) => q.attribution)).size,
  loose: quotes.filter((q) => !q.kind).length,
});
---

<BaseLayout
  title="Citas"
  description="Frases que fui juntando, de los libros y ensayos del sitio y de por ahí."
>
  <header class="page-header">
    <h1 class="page-title">Citas</h1>

    {
      MODES.map((mode) => {
        const { total, authors, loose } = summary(byMode[mode]);

        return (
          <p class="page-intro" data-mode={mode}>
            {total === 0
              ? 'Todavía no hay citas.'
              : `${total} frases de ${authors} ${authors === 1 ? 'autor' : 'autores'}. ${loose} sueltas, el resto salió de los libros y ensayos del sitio.`}
          </p>
        );
      })
    }
  </header>

  {
    MODES.map((mode) => (
      <div class="mt-10 gap-x-12 sm:columns-2" data-mode={mode}>
        {byMode[mode].map((quote) => (
          <QuoteCard quote={quote} />
        ))}
      </div>
    ))
  }
</BaseLayout>
