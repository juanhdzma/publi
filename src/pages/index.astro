---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContentCard from '../components/ContentCard.astro';
import ContentRow from '../components/ContentRow.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { getAllPublished, getPublished, getAllTags, KIND_PATH } from '../lib/content';
import { SITE } from '../config';

const [all, books, essays, tags] = await Promise.all([
  getAllPublished(),
  getPublished('books'),
  getPublished('essays'),
  getAllTags(),
]);

const latest = all.slice(0, 4);
const topTags = tags.slice(0, 8);

const columns = [
  { kind: 'books' as const, title: 'Libros', items: books },
  { kind: 'essays' as const, title: 'Ensayos', items: essays },
];

const stats = [
  { href: '/books/', count: books.length, label: 'libros' },
  { href: '/essays/', count: essays.length, label: 'ensayos' },
  { href: '/tags/', count: tags.length, label: 'categorías' },
];
---

<BaseLayout>
  <section class="border-b border-line pb-8 dark:border-line-dark">
    <h1 class="sr-only">{SITE.title} — {SITE.tagline}</h1>

    <dl class="flex flex-wrap gap-x-10 gap-y-4">
      {
        stats.map(({ href, count, label }) => (
          <div>
            <dt class="sr-only">{label}</dt>
            <dd>
              <a href={href} class="group block">
                <span class="block text-2xl font-semibold tabular-nums transition-colors group-hover:text-accent dark:group-hover:text-accent-dark">
                  {count}
                </span>
                <span class="mt-0.5 block text-sm text-ink-muted dark:text-ink-muted-dark">
                  {label}
                </span>
              </a>
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  {
    topTags.length > 0 && (
      <section class="mt-10">
        <SectionHeader title="Categorías" href="/tags/" />

        <ul class="mt-4 flex flex-wrap gap-2">
          {topTags.map((tag) => (
            <li>
              <a
                href={`/tags/${tag.slug}/`}
                class="inline-flex items-baseline gap-1.5 rounded-full border border-line px-3 py-1 text-sm transition-colors hover:border-accent/40 hover:bg-accent/5 hover:text-accent dark:border-line-dark dark:hover:border-accent-dark/40 dark:hover:bg-accent-dark/10 dark:hover:text-accent-dark"
              >
                {tag.name}
                <span class="text-xs tabular-nums text-ink-muted dark:text-ink-muted-dark">
                  {tag.count}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="mt-10">
    <SectionHeader title="Lo más reciente" />

    {
      latest.length === 0 ? (
        <p class="mt-4 text-ink-muted dark:text-ink-muted-dark">
          Todavía no hay nada publicado.
        </p>
      ) : (
        <div class="mt-5 grid gap-4 sm:grid-cols-2">
          {latest.map((item) => (
            <ContentCard item={item} showKind />
          ))}
        </div>
      )
    }
  </section>

  <div class="mt-12 grid gap-x-10 gap-y-12 sm:grid-cols-2">
    {
      columns.map(({ kind, title, items }) => (
        <section>
          <SectionHeader
            title={title}
            href={`${KIND_PATH[kind]}/`}
            linkLabel="Ver todos"
          />

          {items.length === 0 ? (
            <p class="mt-4 text-sm text-ink-muted dark:text-ink-muted-dark">
              Todavía no hay {title.toLowerCase()}.
            </p>
          ) : (
            <ul class="mt-1">
              {items.map((item) => (
                <ContentRow item={item} />
              ))}
            </ul>
          )}
        </section>
      ))
    }
  </div>
</BaseLayout>
