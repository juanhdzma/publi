---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContentCard from '../components/ContentCard.astro';
import ContentRow from '../components/ContentRow.astro';
import SectionHeader from '../components/SectionHeader.astro';
import TagFilter from '../components/TagFilter.astro';
import { getAllPublished, getPublished, getAllTags, KIND_PATH } from '../lib/content';
import { SITE } from '../config';

const [all, books, essays, tags] = await Promise.all([
  getAllPublished(),
  getPublished('books'),
  getPublished('essays'),
  getAllTags(),
]);

const latest = all.slice(0, 4);
const topTags = tags.slice(0, 8);

const columns = [
  { kind: 'books' as const, title: 'Libros', items: books },
  { kind: 'essays' as const, title: 'Ensayos', items: essays },
];

const stats = [
  { href: '/books/', count: books.length, label: 'libros' },
  { href: '/essays/', count: essays.length, label: 'ensayos' },
  { href: '/tags/', count: tags.length, label: 'categorías' },
];
---

<BaseLayout>
  <section>
    <h1 class="sr-only">{SITE.title} — {SITE.tagline}</h1>

    <dl
      class="grid grid-cols-3 divide-x divide-line border-y border-line dark:divide-line-dark dark:border-line-dark"
    >
      {
        stats.map(({ href, count, label }, i) => (
          <a
            href={href}
            class={`group flex flex-col-reverse gap-1 py-6 transition-colors hover:bg-accent/[0.04] dark:hover:bg-accent-dark/[0.07] ${i === 0 ? 'pr-6' : 'px-6'}`}
          >
            <dt class="text-sm tracking-wide text-ink-muted dark:text-ink-muted-dark">
              {label}
            </dt>
            <dd class="font-serif text-4xl leading-none tabular-nums transition-colors group-hover:text-accent sm:text-5xl dark:group-hover:text-accent-dark">
              {count}
            </dd>
          </a>
        ))
      }
    </dl>
  </section>

  <section class="mt-10">
    <SectionHeader title="Lo más reciente" />

    {
      latest.length === 0 ? (
        <p class="mt-4 text-ink-muted dark:text-ink-muted-dark">
          Todavía no hay nada publicado.
        </p>
      ) : (
        <div class="mt-5 grid gap-4 sm:grid-cols-2">
          {latest.map((item) => (
            <ContentCard item={item} showKind />
          ))}
        </div>
      )
    }
  </section>

  <section class="mt-14">
    <SectionHeader title="Todo el archivo" href="/tags/" linkLabel="Ver categorías" />

    <div class="mt-5">
      <TagFilter tags={topTags} total={all.length} />
    </div>

    <div class="mt-8 grid gap-x-10 gap-y-12 sm:grid-cols-2">
      {
        columns.map(({ kind, title, items }) => (
          <div>
            <h3 class="border-b border-line pb-2 text-xs font-semibold tracking-[0.12em] text-ink-muted uppercase dark:border-line-dark dark:text-ink-muted-dark">
              <a
                href={`${KIND_PATH[kind]}/`}
                class="transition-colors hover:text-accent dark:hover:text-accent-dark"
              >
                {title}
              </a>
            </h3>

            <ul class="mt-1" data-filterable>
              {items.map((item) => (
                <ContentRow item={item} />
              ))}
            </ul>

            <p
              class="mt-4 text-sm text-ink-muted dark:text-ink-muted-dark"
              data-empty
              hidden={items.length > 0}
            >
              Nada en {title.toLowerCase()} con este filtro.
            </p>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>
