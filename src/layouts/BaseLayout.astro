---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import { SITE } from '../config';

/* Solo los subsets latin en peso normal: son los únicos que un lector en
   español baja al entrar, y precargarlos evita el flash con la font de
   fallback. Los demás subsets e itálicas los pide el navegador si hacen falta. */
import serifFont from '@fontsource-variable/crimson-pro/files/crimson-pro-latin-wght-normal.woff2?url';
import sansFont from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';

type Props = {
  title?: string;
  description?: string;
};

const { title, description = SITE.description } = Astro.props;

const pageTitle = title ? `${title} · ${SITE.title}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);

const nav = [
  { href: '/books/', label: 'Libros' },
  { href: '/essays/', label: 'Ensayos' },
  { href: '/quotes/', label: 'Citas' },
  { href: '/tags/', label: 'Categorías' },
];

const path = Astro.url.pathname;
---

<html lang="es" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="preload" href={serifFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sansFont} as="font" type="font/woff2" crossorigin />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#fcfcfa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1c1d21" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />

    <script is:inline>
      const stored = localStorage.getItem('theme');
      const dark = stored
        ? stored === 'dark'
        : matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.classList.toggle('dark', dark);
    </script>
  </head>

  <body class="flex min-h-full flex-col">
    <header
      class="sticky top-0 z-20 border-b border-line bg-paper/85 backdrop-blur-md dark:border-line-dark dark:bg-paper-dark/85"
    >
      <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-6 py-4">
        <a
          href="/"
          class="font-semibold tracking-tight transition-colors hover:text-accent dark:hover:text-accent-dark"
        >
          {SITE.title}
        </a>

        <nav class="flex items-center gap-0.5 text-sm">
          {
            nav.map(({ href, label }) => (
              <a
                href={href}
                aria-current={path.startsWith(href) ? 'page' : undefined}
                class="rounded-md px-2 py-1.5 text-ink-muted transition-colors hover:text-ink aria-[current]:font-medium aria-[current]:text-ink dark:text-ink-muted-dark dark:hover:text-ink-dark dark:aria-[current]:text-ink-dark"
              >
                {label}
              </a>
            ))
          }
          <ThemeToggle />
        </nav>
      </div>
    </header>

    <main class="mx-auto w-full max-w-5xl flex-1 px-6 py-12">
      <slot />
    </main>

    <footer class="border-t border-line dark:border-line-dark">
      <div class="mx-auto max-w-5xl px-6 py-6 text-sm text-ink-muted dark:text-ink-muted-dark">
        <span>{SITE.author}</span>
      </div>
    </footer>
  </body>
</html>
