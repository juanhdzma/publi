---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import ContentToggle from '../components/ContentToggle.astro';
import { SITE, THEME_COLOR } from '../config';

/* Solo los subsets latin en peso normal: son los únicos que un lector en
   español baja al entrar, y precargarlos evita el flash con la font de
   fallback. Los demás subsets e itálicas los pide el navegador si hacen falta. */
import serifFont from '@fontsource-variable/crimson-pro/files/crimson-pro-latin-wght-normal.woff2?url';
import sansFont from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';

type Props = {
  title?: string;
  description?: string;
  /** `article` en las entradas; el resto del sitio es `website`. */
  type?: 'website' | 'article';
  publishedAt?: Date;
};

const {
  title,
  description = SITE.description,
  type = 'website',
  publishedAt,
} = Astro.props;

const pageTitle = title ? `${title} · ${SITE.title}` : SITE.title;
const base = Astro.site ?? Astro.url;
const canonical = new URL(Astro.url.pathname, base);

/* Las redes no resuelven rutas relativas: la preview necesita URL absoluta. */
const ogImage = new URL('/og.png', base);
const feed = new URL('/rss.xml', base);

const nav = [
  { href: '/books/', label: 'Libros' },
  { href: '/essays/', label: 'Ensayos' },
  { href: '/quotes/', label: 'Citas' },
  { href: '/tags/', label: 'Categorías' },
];

const path = Astro.url.pathname;
---

{/* `real` de arranque: sin JS, el sitio muestra el contenido real y nada más. */}
<html lang="es" class="h-full" data-content="real">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE.title} — ${SITE.tagline}`}
      href={feed}
    />

    <link rel="preload" href={serifFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sansFont} as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {/* Sin `media`: el tema puede estar forzado por el toggle, y entonces
        prefers-color-scheme dice lo contrario. Lo resuelve el script de abajo. */}
    <meta
      name="theme-color"
      content={THEME_COLOR.light}
      data-light={THEME_COLOR.light}
      data-dark={THEME_COLOR.dark}
    />

    <meta property="og:type" content={type} />
    {
      publishedAt && (
        <meta property="article:published_time" content={publishedAt.toISOString()} />
      )
    }
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`Logo de ${SITE.title}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline>
      /* localStorage tira en Safari private y en iframes con third-party
         cookies bloqueadas. Sin el try, el sitio se queda sin tema. */
      let stored = null;
      try {
        stored = localStorage.getItem('theme');
      } catch {}

      const dark = stored
        ? stored === 'dark'
        : matchMedia('(prefers-color-scheme: dark)').matches;

      document.documentElement.classList.toggle('dark', dark);

      const meta = document.querySelector('meta[name="theme-color"]');
      meta?.setAttribute('content', dark ? meta.dataset.dark : meta.dataset.light);

      /* El modo se resuelve antes del paint: si no, el contenido del modo
         inactivo parpadea. Una URL /demo/ lo fuerza, para que un link directo
         a una ficha de pruebas no caiga en una página que se ve vacía. */
      let content = null;
      try {
        content = localStorage.getItem('content');
      } catch {}

      if (location.pathname.split('/').includes('demo')) content = 'demo';
      document.documentElement.dataset.content = content === 'demo' ? 'demo' : 'real';
    </script>
  </head>

  <body class="flex min-h-full flex-col">
    <a href="#main" class="skip-link">Saltar al contenido</a>

    <header
      class="sticky top-0 z-20 border-b border-line bg-paper/85 backdrop-blur-md dark:border-line-dark dark:bg-paper-dark/85"
    >
      <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-6 py-4">
        <a href="/" class="site-brand">
          <img src="/favicon.svg" alt="" width="30" height="30" class="site-mark" />
          {SITE.title}
        </a>

        <nav class="flex items-center gap-0.5 text-sm">
          {
            nav.map(({ href, label }) => (
              <a
                href={href}
                aria-current={path.startsWith(href) ? 'page' : undefined}
                class="rounded-md px-2 py-1.5 text-ink-muted transition-colors hover:text-ink aria-[current]:font-medium aria-[current]:text-ink dark:text-ink-muted-dark dark:hover:text-ink-dark dark:aria-[current]:text-ink-dark"
              >
                {label}
              </a>
            ))
          }
          <ContentToggle />
          <ThemeToggle />
        </nav>
      </div>
    </header>

    <main id="main" class="main mx-auto w-full max-w-5xl flex-1 px-6 py-12">
      <slot />
    </main>

    <footer class="border-t border-line dark:border-line-dark">
      <div class="mx-auto max-w-5xl px-6 py-6 text-sm text-ink-muted dark:text-ink-muted-dark">
        <span>{SITE.author}</span>
      </div>
    </footer>
  </body>
</html>
