---
import BaseLayout from './BaseLayout.astro';
import Rating from '../components/Rating.astro';
import TagList from '../components/TagList.astro';
import PullQuote from '../components/PullQuote.astro';
import References from '../components/References.astro';
import QuoteList from '../components/QuoteList.astro';
import {
  KIND_PATH,
  KIND_PLURAL,
  formatDate,
  type Kind,
  type Mode,
  type Quote,
} from '../lib/content';

type Reference = {
  title: string;
  author?: string;
  year?: string;
  url?: string;
  note?: string;
};

type Props = {
  kind: Kind;
  mode: Mode;
  title: string;
  summary: string;
  publishedAt: Date;
  tags: string[];
  readingMinutes: number;
  references: Reference[];
  quotes: Quote[];
  author?: string;
  rating?: number;
};

const {
  kind,
  mode,
  title,
  summary,
  publishedAt,
  tags,
  readingMinutes,
  references,
  quotes,
  author,
  rating,
} = Astro.props;

const featured = quotes.find((q) => q.featured);
const rest = quotes.filter((q) => q !== featured);
---

<BaseLayout title={title} description={summary} type="article" publishedAt={publishedAt}>
  <a href={`${KIND_PATH[kind]}/`} class="section-link">
    <span aria-hidden="true">←</span>
    {KIND_PLURAL[kind]}
  </a>

  {
    mode === 'demo' && (
      <p class="demo-note mt-6">
        Ficha de ejemplo. No es contenido publicado — sirve para ver cómo queda una
        entrada real.
      </p>
    )
  }

  <article class="mx-auto max-w-[68ch]">
    <header class="page-header mt-6">
      <div class="meta-row">
        <time datetime={publishedAt.toISOString()}>{formatDate(publishedAt)}</time>
        <span aria-hidden="true">·</span>
        <span>{readingMinutes} min de lectura</span>
      </div>

      <h1 class="page-title mt-3">{title}</h1>

      {
        author && (
          <p class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-ink-muted dark:text-ink-muted-dark">
            <span>{author}</span>
            {rating && <Rating value={rating} />}
          </p>
        )
      }

      <p class="page-intro">{summary}</p>

      <div class="mt-5">
        <TagList tags={tags} />
      </div>
    </header>

    {
      featured && (
        <PullQuote
          text={featured.text}
          source={featured.attribution}
          page={featured.page}
        />
      )
    }

    <div class="prose-publi mt-9">
      <slot />
    </div>

    <QuoteList quotes={rest} />

    <References references={references} />
  </article>

  <nav class="mx-auto mt-14 max-w-[68ch] border-t border-line pt-6 dark:border-line-dark">
    <a href={`${KIND_PATH[kind]}/`} class="section-link">
      <span aria-hidden="true">←</span> Ver todos los {KIND_PLURAL[kind].toLowerCase()}
    </a>
  </nav>
</BaseLayout>
