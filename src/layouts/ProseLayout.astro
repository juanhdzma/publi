---
import BaseLayout from './BaseLayout.astro';
import Rating from '../components/Rating.astro';
import TagList from '../components/TagList.astro';
import PullQuote from '../components/PullQuote.astro';
import References from '../components/References.astro';
import QuoteList from '../components/QuoteList.astro';
import { KIND_PATH, KIND_PLURAL, formatDate, type Kind, type Quote } from '../lib/content';

type Reference = {
  title: string;
  author?: string;
  year?: string;
  url?: string;
  note?: string;
};

type Props = {
  kind: Kind;
  title: string;
  summary: string;
  publishedAt: Date;
  tags: string[];
  readingMinutes: number;
  references: Reference[];
  quotes: Quote[];
  author?: string;
  rating?: number;
};

const {
  kind,
  title,
  summary,
  publishedAt,
  tags,
  readingMinutes,
  references,
  quotes,
  author,
  rating,
} = Astro.props;

const featured = quotes.find((q) => q.featured);
const rest = quotes.filter((q) => q !== featured);
---

<BaseLayout title={title} description={summary}>
  <a
    href={`${KIND_PATH[kind]}/`}
    class="inline-flex items-center gap-1.5 text-sm text-ink-muted transition-colors hover:text-ink dark:text-ink-muted-dark dark:hover:text-ink-dark"
  >
    <span aria-hidden="true">←</span>
    {KIND_PLURAL[kind]}
  </a>

  <article class="mx-auto max-w-[68ch]">
    <header class="mt-6 border-b border-line pb-7 dark:border-line-dark">
      <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1 text-xs text-ink-muted dark:text-ink-muted-dark">
        <time datetime={publishedAt.toISOString()}>{formatDate(publishedAt)}</time>
        <span aria-hidden="true">·</span>
        <span>{readingMinutes} min de lectura</span>
      </div>

      <h1 class="mt-3 font-serif text-4xl leading-tight tracking-tight text-balance sm:text-5xl">
        {title}
      </h1>

      {
        author && (
          <p class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-ink-muted dark:text-ink-muted-dark">
            <span>{author}</span>
            {rating && <Rating value={rating} />}
          </p>
        )
      }

      <p class="mt-4 text-lg leading-relaxed text-pretty text-ink-muted dark:text-ink-muted-dark">
        {summary}
      </p>

      <div class="mt-5">
        <TagList tags={tags} />
      </div>
    </header>

    {
      featured && (
        <PullQuote
          text={featured.text}
          source={featured.attribution}
          page={featured.page}
        />
      )
    }

    <div class="prose-publi mt-9">
      <slot />
    </div>

    <QuoteList quotes={rest} />

    <References references={references} />
  </article>

  <nav class="mx-auto mt-14 max-w-[68ch] border-t border-line pt-6 dark:border-line-dark">
    <a
      href={`${KIND_PATH[kind]}/`}
      class="text-sm text-ink-muted transition-colors hover:text-ink dark:text-ink-muted-dark dark:hover:text-ink-dark"
    >
      <span aria-hidden="true">←</span> Ver todos los {KIND_PLURAL[kind].toLowerCase()}
    </a>
  </nav>
</BaseLayout>
